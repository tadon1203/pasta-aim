{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo: check",
            "type": "process",
            "command": "cargo",
            "args": [
                "check"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: fmt",
            "type": "process",
            "command": "cargo",
            "args": [
                "fmt",
                "--all"
            ],
            "problemMatcher": []
        },
        {
            "label": "cargo: fmt check",
            "type": "process",
            "command": "cargo",
            "args": [
                "fmt",
                "--all",
                "--",
                "--check"
            ],
            "problemMatcher": []
        },
        {
            "label": "cargo: clippy",
            "type": "process",
            "command": "cargo",
            "args": [
                "clippy",
                "--all-targets",
                "--all-features",
                "--",
                "-D",
                "warnings"
            ],
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: test",
            "type": "process",
            "command": "cargo",
            "args": [
                "test"
            ],
            "group": "test",
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: verify",
            "dependsOrder": "sequence",
            "dependsOn": [
                "cargo: fmt check",
                "cargo: clippy",
                "cargo: test"
            ],
            "problemMatcher": []
        },
        {
            "label": "cargo: run",
            "type": "process",
            "command": "cargo",
            "args": [
                "run"
            ],
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo: build release",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--release"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}
